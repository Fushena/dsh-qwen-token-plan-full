import { assertUsableApiKey } from "@deepseek-ai/dsh-llm";
import { credentialRef } from "@deepseek-ai/dsh-credentials";

/**
 * 凭据解析：DSH 凭据服务 → 环境变量。每次调用重新解析（改 Key 不用重启）。
 * 找不到时抛 MISSING_CREDENTIAL，由调用方决定是否降级。
 */
export async function resolveApiKey(ctx, apiKeyEnv, pluginName) {
  const service = ctx.get?.("credentials");
  const hit = service ? await service.resolve(credentialRef(apiKeyEnv)) : undefined;
  const raw = hit?.value ?? process.env[apiKeyEnv];
  return assertUsableApiKey(raw, pluginName, apiKeyEnv);
}

/** 软解析：拿不到 Key 返回 undefined，不抛错（目录刷新等后台任务用）。 */
export async function tryResolveApiKey(ctx, apiKeyEnv, pluginName) {
  try {
    return await resolveApiKey(ctx, apiKeyEnv, pluginName);
  } catch {
    return undefined;
  }
}
